# Vercel envs (set in Vercel project Settings → Environment Variables)
# Client-visible (exposed to browser):
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only (NEVER expose, do NOT prefix with VITE_):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Anthropic (chat + session titles)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (live mode only)
STRIPE_SECRET_KEY=sk_live_...
PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_...
VITE_PAYMENTS_CLIENT_TOKEN=pk_live_...

# MailerLite
MAILERLITE_API_KEY=
MAILERLITE_COMMUNITY_GROUP_ID=
MAILERLITE_CONTRIBUTORS_GROUP_ID=
# Optional — dedicated Sunya list for EmailCapture; falls back to COMMUNITY
MAILERLITE_SUNYA_GROUP_ID=
# Optional — if unset, gatherings signup uses MAILERLITE_COMMUNITY_GROUP_ID
MAILERLITE_GATHERINGS_GROUP_ID=
